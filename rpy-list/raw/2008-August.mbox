+class VectorizeTestCase(unittest.TestCase):
+
+    def simpleFunction(self, subject_fun):
+        def f(x):
+            return x ** 2
+        f_iter = subject_fun(f)
+
+        seq = (1, 2, 3)
+        res = f_iter(seq)
+
+        for va, vb in itertools.izip(seq, res):
+            self.assertEquals(va ** 2, vb)
+
+    def testIterify(self):
