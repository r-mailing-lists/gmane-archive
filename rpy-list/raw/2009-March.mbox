I'd say that it is *currently* possible, and with few lines of Python.


import rpy2.robjects as ro

def rparse(x):
   res = ro.baseNameSpaceEnv["parse"](text = x)
   return res

rlocal = ro.r['local']
def my_eval(fun_name, arg_names, env):
   res = rlocal(rparse('withVisible(%s(%s))' %(fun_name, ', 
'.join(arg_names))), env)
   return res

ro.globalEnv['x'] = ro.IntVector([1,2,3])
# I am not certain of why you want that
ro.globalEnv['sum'] = ro.r['sum']

print(my_eval('sum', ('x', ), ro.globalEnv))




