>    sum((alpha*log(beta) + lgamma(alpha + x) + x * log(dicerAcc) -
> lgamma(alpha) - (alpha + x) * log(beta+dicerAcc) - lfactorial(x))[dicerAcc
>> noiseT]) ab<- optim(c(1,100), alphabeta, control=list(fnscale=-1), x =
