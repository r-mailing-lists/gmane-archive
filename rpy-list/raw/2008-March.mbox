+Sexp_do_slot(PyObject *self, PyObject *name)
+{
+  SEXP sexp =((SexpObject*)self)->sexp;
+  if (! sexp) {
+    PyErr_Format(PyExc_ValueError, "NULL SEXP.");
+    return NULL;;
+  }
+  if (! PyString_Check(name)) {
