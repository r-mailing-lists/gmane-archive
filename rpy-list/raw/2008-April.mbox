+
+  //self = (PySexpObject *)_PyObject_New(&type);
+  self = (PySexpObject *)type->tp_alloc(type, 0);
+  if (! self)
+    PyErr_NoMemory();
+
+  self->sObj = (SexpObject *)calloc(1, sizeof(SexpObject));
+  if (! self->sObj)
+    PyErr_NoMemory();
+
+  RPY_GETCOUNT(self) = 1;
+  RPY_GETSEXP(self) = R_NilValue;
+
+  #ifdef RPY_VERBOSE
