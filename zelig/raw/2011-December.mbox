MH6 <- zelig(onset ~ L_PC_PRODUCTION + L_PC_RESERVES + L_PC_DIAMONDS
             + L_wdiagdp, data = mhd, model = "relogit", tau = 88/5269,
             case.control = "weighting", robust = TRUE)

