Hi Zsófia and James,

I've came to another possible solution which allows "dem.func" to be used
as a simpler function, without the need for aditional commands. I think it
worked fine.


#########################
rm(list=ls())
library(Zelig)
library(ZeligChoice)

data(mexico)

dem.func = function(aaa,bbb,ccc){
  z.out = zelig(as.factor(vote88)~pristr + othcok + othsocok,
model="mlogit", data=mexico)
  options = list(z.out, pristr=aaa, othcok=bbb, othsocok=ccc)
  x.weak = do.call(setx, options)
  return(x.weak)
}

dem.func(1,2,3)
#########################


