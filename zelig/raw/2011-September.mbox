tx.var <- c("TREAT")
causal.model <- QASBAT ~ TREAT + T + T2 + T3 + tag(T | ID.factor)

(some other codes here)
 
z.out.1 <- zelig(formula= as.formula(causal.model), data=matched.1.mtch.long,   model="ls.mixed")
