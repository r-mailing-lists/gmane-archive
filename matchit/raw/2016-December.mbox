                     s1lem_ml + s1lem_ms + s1lem_mr + 
                     s1sc + s1fee + 
                     s1sf_la + s1sf_lb + s1sf_ma + s1sf_mb + s1sf_ea + s1sf_eb + 
                     e1hh + e1em + e1ex + 
                     e1ag + e1co + e1op + 
                     e1sozk + Zgc_c + Zgf_c + teilgenommen_c,
                   data = impute1,
                   distance = impute1$PS,
