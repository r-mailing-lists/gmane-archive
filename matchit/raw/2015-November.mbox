> mod.ps3<-lm(re78~treat+age+educ+black+hispan+married+nodegree+re74+re75,data
> = m.data3)
>
> summary(mod.reg);summary(mod.ps1);summary(mod.ps11);summary(mod.ps2);summary(mod.ps3)
