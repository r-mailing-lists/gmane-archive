import org.rosuda.JGR.JGR;
import org.rosuda.REngine.REXPMismatchException;
import org.rosuda.REngine.REngineException;

/**
  *
  * @author dev
  */
public class JgrPilot {

     /**
      * @param args the command line arguments
      */
     public static void main(final String[] args) throws 
REngineException, REXPMismatchException, InterruptedException{
         // TODO code application logic here
         System.out.println("test0");

         Thread t;
         t = new Thread(new Runnable() {
             @Override
             public void run() {
                 JGR.main(args);
             }
         }
         );
         t.start();
         System.out.println("test1");
         do { Thread.sleep(1000);} while (JGR.MAINRCONSOLE == null);
         System.out.println(JGR.MAINRCONSOLE == null);
         System.out.println(JGR.getREngine() == null);
         JGR.STARTED=true;
         JGR.MAINRCONSOLE.input.append("ls()");
         //JGR.MAINRCONSOLE.wait();
         JGR.MAINRCONSOLE.execute("a<-1");
     }
}

