wanted to find out how to do is.na( x ) without calling the is.na 
function in R. See this class:

import org.rosuda.JRI.Rengine;
import org.rosuda.JRI.REXP;

public class NumericNA {
    public static void main(String[] args) {
    Rengine re=new Rengine(args, false, null);
    re.waitForR();
           
        showDouble( "NA_real_"     , re ) ;
        showDouble( "NaN"    , re ) ;
     //   showDouble( "Inf"    , re ) ;
     //    showDouble( "-Inf"   , re ) ;
       
        System.exit( 0 );
       
    }
       
        public static void showDouble( String x, Rengine re ){
            double d = re.eval( x ).asDouble() ;
            System.out.println( "R expression    = " + x  );
            System.out.println( "    double      = " + d  );
            System.out.println( "    isNaN       = " + Double.isNaN(d) ) ;
            System.out.println( "    isInfinite  = " + 
Double.isInfinite(d) ) ;
            System.out.println( "    raw bytes   = " + 
Double.doubleToRawLongBits(d) ) ;
            System.out.println( "    hex         = " + Long.toHexString( 
Double.doubleToRawLongBits(d) ) ) ;
            System.out.println( "    octal       = " + 
Long.toOctalString( Double.doubleToRawLongBits(d) ) ) ;
            System.out.println( "    binary      = " + 
Long.toBinaryString( Double.doubleToRawLongBits(d) ) ) ;
            System.out.println("" );
        }      
}

