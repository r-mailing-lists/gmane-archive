import java.lang.reflect.Method;

/**
 * @author Romain Francois <francoisromain at free.fr>
 *
 */
public class ReflectionTools {

	public static Method getMethod( Class<?> o_clazz, String name, Class<?>[] arg_clazz ) throws AmbiguousMethodComparisonException{

		if( o_clazz == null){
			return null; 
		}

		/* if there is no argument, try to find a match */
		if( arg_clazz == null || arg_clazz.length == 0) {
			try {
				Method m = o_clazz.getMethod(name, (Class<?>)null) ;
				if( m != null){
					return m ;
				}
			} catch (SecurityException e) {
			} catch (NoSuchMethodException e) {
			}
		}

		/* try to find an exact match */
		Method met;
		try {
			met = o_clazz.getMethod(name, arg_clazz);
			if( met != null){
				return met ;
			}
		} catch (SecurityException e) {
		} catch (NoSuchMethodException e) {
		}
		
		met = null; 
		for( Method m: o_clazz.getMethods()){
			if( ! m.getName().equals(name) ){
				continue; 
			}
			Class<?>[] param_clazz = m.getParameterTypes() ;
			if( arg_clazz.length != param_clazz.length ){
				continue; 
			}
			int n = arg_clazz.length ;
			boolean ok = true; 
			for( int i=0; i<n; i++){
				if( ! param_clazz[i].isAssignableFrom(arg_clazz[i])){
					ok = false; 
					break ;
				}
			}
			if( ok ){
				if( met == null){
					met = m; 
				} else{
					if( isMoreSpecific( m, met) ){
						met = m ; 
					}
				}
			}
		}
		return met; 

	}

	private static boolean isMoreSpecific( Method m1, Method m2) throws AmbiguousMethodComparisonException{
		Class<?>[] m1_param_clazz = m1.getParameterTypes() ;
		Class<?>[] m2_param_clazz = m2.getParameterTypes() ;
		int n = m1_param_clazz.length ;
		int res = 0; 
		for( int i=0; i<n; i++){
			if( m1_param_clazz[i] == m2_param_clazz[i]){
				// keep going 
			} else if( m1_param_clazz[i].isAssignableFrom(m2_param_clazz[i])){
				if( res <= 0){
					res = -1; 
				} else{
					throw new AmbiguousMethodComparisonException( ) ; 
				}
			} else if( m2_param_clazz[i].isAssignableFrom(m1_param_clazz[i]) ){
				if( res >= 0){
					res = 1; 
				} else{
					throw new AmbiguousMethodComparisonException( ) ;
				}
			}
		}
		return res > 0; 

	}
		
	@SuppressWarnings("serial")
	private static class AmbiguousMethodComparisonException extends Exception{
		public AmbiguousMethodComparisonException(){
			super(); 
		}
	}


}

