    public void rWriteConsole(Rengine re, String text) {
        try {
                String log = text;
                StyledDocument logDoc = QTL.qtlFrame.getLogDoc();
                // don't show the warning message of re.eval()
                String tail = "";
                if (logDoc.getLength() > 2)
                    tail = logDoc.getText(logDoc.getLength()-2, 2);
                if (tail.indexOf(">") == -1) {
                    logDoc.insertString(logDoc.getLength(), log, logDoc.getStyle(R_FEEDBACK));
                }
                else {
                }
                QTL.qtlFrame.getOutputPane().setCaretPosition(logDoc.getLength());
        }
        catch (BadLocationException ble) {
            ble.printStackTrace();
        }
    }

Thanks,
Lei


