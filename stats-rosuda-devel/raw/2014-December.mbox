  objectInputStream = .jnew("CustomObjectInputStream",
.jcast(fileInputStream, new.class="java/io/InputStream"),
.jcast(.jclassLoader(), new.class="java.lang.ClassLoader"))
  .jcall(objectInputStream, "Ljava/lang/Object;", "readObject", check=TRUE)
}


