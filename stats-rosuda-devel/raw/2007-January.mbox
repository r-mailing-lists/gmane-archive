#!/bin/bash
#
# tomcat       
#
# chkconfig:
# description:  Start up the Tomcat servlet engine.

# Source function library.
#. /etc/init.d/functions
. /lib/lsb/init-functions


RETVAL=$?
DAEMON="/usr/bin/R"
OPTIONS="CMD Rserve --gui-none --RS-conf /etc/Rserve.conf"
USER=nobody
PIDFILE=/var/run/rserve.pid

# Make dead sure Rserv does not try to open X11 !!!
unset DISPLAY

case "$1" in
 start)
        log_begin_msg "Starting rserve..."
        start-stop-daemon -S -o -q -p $PIDFILE -x $DAEMON -u $USER -a 
/bin/su -- -c "$DAEMON $OPTIONS" $USER
        log_end_msg $?
        ;;
 stop)
        log_begin_msg "Stopping rserve..."
        start-stop-daemon -K -o -q -p $PIDFILE -x $DAEMON -u $USER
        killall /usr/lib/R/bin/Rserve
        log_end_msg $?
        ;;
 force-reload|restart)
        sh $0 stop
        sh $0 start
        ;;
 *)
        echo $"Usage: $0 {start|stop|force-reload|restart}"
        exit 1
        ;;
esac

exit $RETVAL

