        String x="";
        if(  data.phoneNumber(vars[permA[popXId]]) ) {
          x = " " + data.getName(vars[permA[popXId]])+'\n'+" Number\t "+ Util.toPhoneNumber(dataCopy[permA[popXId]][popYId]);
        }
        else if( data.categorical(vars[permA[popXId]]) )
          if( paintMode.equals("Poly") ) {
