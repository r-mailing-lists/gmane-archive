            else if( alpha >= 0.099 )
              alpha01.setState(true);
            else if( alpha >= 0.049 )
              alpha005.setState(true);
            else if( alpha >= 0.0099 )
              alpha001.setState(true);
            else if( alpha >= 0.0049 )
