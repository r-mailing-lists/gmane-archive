  public String getToolTipText(MouseEvent e) {
    if( e.isControlDown() && !e.isAltDown() ) {
      if( smoothF.equals("ls-line") && Math.abs( (int)userToWorldY( worldToUserX(e.getX()) * coeffs[1] + coeffs[0]) - e.getY() ) < 4 ) {
