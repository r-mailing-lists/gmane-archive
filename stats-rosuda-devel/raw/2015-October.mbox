            // in a package (say, my.package), this should be set to
            // my/package/MyJavaGD1.
            
            _re.eval(".setenv('JAVAGD_CLASS_NAME'='moneytrax/MyJavaGD2')");
            _re.eval("library(JavaGD)");
            _re.eval("JavaGD()");
            

        }

        /**
