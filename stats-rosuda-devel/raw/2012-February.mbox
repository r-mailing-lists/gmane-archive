Hi there.

I have been able to replicate the problem with a sample program that roughly replicates what I'm actually doing. You can copy & paste the whole code and execute it, and you'll see the Exception been thrown.
Although it might seem a bit redundant, the final program is intended to transform "any" data structure into R data structures. Hope this helps to find an error in my side, or a bug in the library.

Víctor

import java.util.ArrayList;

import org.rosuda.REngine.REXP;
import org.rosuda.REngine.REXPList;
import org.rosuda.REngine.REXPMismatchException;
import org.rosuda.REngine.REXPWrapper;
import org.rosuda.REngine.RList;
import org.rosuda.REngine.Rserve.RConnection;
import org.rosuda.REngine.Rserve.RserveException;

/**
Created by @victor
Feb 14, 2012
 */

public class TestDataFrame {
	RConnection rConn;
	
	public TestDataFrame() {
		try {
			rConn = new RConnection();
		} catch (RserveException e) {
			e.printStackTrace();
		}
	}
	
	public REXP createDataFrame(ArrayList<ArrayList> dataFrame) throws REXPMismatchException {
		RList rList;
		ArrayList<REXP> rexpValues = new ArrayList<REXP>();
		ArrayList<String> names = new ArrayList<String>();
		REXP column;
		int i = 0;
		
		for (ArrayList a : dataFrame) {
			column = encodeList(a);
			rexpValues.add(column);
			names.add("Column_" + i);
		}
		
		rList = new RList(rexpValues, names);
		
		return REXP.createDataFrame(rList);
	}
	
	protected REXP encodeList(ArrayList a) {
		RList rList;
		ArrayList<REXP> rexpValues = new ArrayList<REXP>();
		ArrayList<String> names = new ArrayList<String>();
		int i = 0;
		
		for (Object obj : a) {
			rexpValues.add(REXPWrapper.wrap(obj));
			names.add("Pos_" + i);
			i++;
		}
		
		rList = new RList(rexpValues, names);
		return new REXPList(rList);
	}
	
	public void assignREXPToVar(REXP rexp, String varName) throws RserveException {
		rConn.assign(varName, rexp);
	}
	
	public static void main(String[] args) {
		TestDataFrame test = new TestDataFrame();
		
		ArrayList<ArrayList> table = new ArrayList<ArrayList>();
		ArrayList array1 = new ArrayList();
		array1.add("");
		array1.add("aaa");
		array1.add(1);
		array1.add(1);
		table.add(array1);
		
		ArrayList array2 = new ArrayList();
		array2.add("");
		array2.add("bbb");
		array2.add(2);
		array2.add(2);
		table.add(array2);
		
		ArrayList array3 = new ArrayList();
		array3.add("");
		array3.add("ccc");
		array3.add(3);
		array3.add(3);
		table.add(array3);
		
		try {
			REXP rexp = test.createDataFrame(table);
			test.assignREXPToVar(rexp, "var1");
		} catch (REXPMismatchException e) {
			e.printStackTrace();
		} catch (RserveException e) {
			e.printStackTrace();
		}
	}
}


