redshift).

library(RPostgreSQL)
drv <- dbDriver("PostgreSQL")
con <- dbConnect(drv,
                 host='<host>',
                 port='5432',
                 dbname='<dbname>',
                 user='<username>',
                 password='<password>')

Error in postgresqlNewConnection(drv, ...) : 
  RS-DBI driver: (could not connect <username>@<host> on dbname "<dbname>"
