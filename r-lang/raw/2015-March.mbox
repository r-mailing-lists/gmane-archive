   TN_LEX_nominalisierung + prep_meaning + TN_LEX_GN_Kommunikation + 
   TN_LEX_GN_Besitz + TN_LEX_GN_Attribut + TN_LEX_GN_Geschehen + 
   (1 | target_noun_lemma), data = mit.050315.data, family = binomial(), 
