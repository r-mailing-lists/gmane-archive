contrasts(SoleTrain$Listener.f) = contr.treatment(2)
SoleTrain$SyntaxType.f = factor(SoleTrain$SyntaxType, labels=c("Transitive", "Locative", "Dative"))
contrasts(SoleTrain$SyntaxType.f) = contr.treatment(3)

# Create full model:
SoleTrain.full<- glmer(Target_E2_pref ~ Listener.f*SyntaxType.f + (1 + Listener.f*SyntaxType.f|Subject) + (1 + Listener.f|Picture), data = SoleTrain, family = binomial, verbose=T, control=glmerControl(optCtrl=list(maxfun=20000)))

