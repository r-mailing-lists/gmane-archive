SoleTrain.noListener<- glmer(Target_E2_pref ~ SyntaxType.f + Listener.f:SyntaxType.f + (1 + Listener.f*SyntaxType.f|Subject) + (1 + Listener.f|Picture), data = SoleTrain, family = binomial, verbose=T, control=glmerControl(optCtrl=list(maxfun=20000)))

