From henrik.singmann-RoHN3oFRSd0z1rruF8NHbrn0aRqv+C64G9Ur7JDdleE at public.gmane.org  Thu May  8 14:26:31 2014
From: henrik.singmann-RoHN3oFRSd0z1rruF8NHbrn0aRqv+C64G9Ur7JDdleE at public.gmane.org (Henrik Singmann)
Date: Thu, 08 May 2014 16:26:31 +0200
Subject: Re: bug in lmer or in my head?
In-Reply-To: <536AFF8F.8090805@ccu.edu.tw>
References: <CAMLCjkyBXu+Rm6wC+pMwssPqjKuaE9NnYUHFP9xoKN9oNtNx2g@mail.gmail.com> <67D909CD-542C-4733-9442-C1481CC6110B@ucsd.edu> <536AFF8F.8090805@ccu.edu.tw>
Message-ID: <536B9417.3060401@psychologie.uni-freiburg.de>



Hi James,

like others have said, this is by design of how R treats formulas. I had this exact questions some time ago and asked on SO on how to avoid this: http://stackoverflow.com/q/11335923/289572

Out of this discussion I developed the mixed function in the afex package which circumvents this problem by manually altering the model matrix. This function gives you the p-values right away and replicates your results (with one caveat described below).

require(afex)

ddat = read.delim("http://www.ccunix.ccu.edu.tw/~lngproc/doramiR.txt")
ddat = na.omit(ddat)
contrasts(ddat$Education) = contr.sum(levels(ddat$Education)) # 1 = College
contrasts(ddat$SynCat) = contr.sum(levels(ddat$SynCat)) # 1 = Noun
contrasts(ddat$Freq) = contr.sum(levels(ddat$Freq)) # 1 = High

m1 <- mixed(RT~Education*SynCat*Freq+((SynCat*Freq)|Participant)+(Education|Item), data = ddat, method = "LRT", check.contrasts=FALSE)
m1

##                  Effect df.large df.small chisq df p.value
## 1             Education       22       21  0.00  1     .97
## 2                SynCat       22       21  2.71  1     .10
## 3                  Freq       22       21  9.64  1    .002
## 4      Education:SynCat       22       21  0.02  1     .90
## 5        Education:Freq       22       21  2.90  1     .09
## 6           SynCat:Freq       22       21  0.20  1     .65
## 7 Education:SynCat:Freq       22       21  0.07  1     .79

## Warning message:
## In print.mixed(list(anova.table = list(Effect = c("Education", "SynCat",  :
##   lme4 reported (at least) the following warnings for 'Freq':
##   * Model failed to converge with max|grad| = 26.6937 (tol = 0.002)
##   * Model failed to converge: degenerate  Hessian with 1 negative eigenvalues


# this replicates your results when fitting with REML = FALSE
ddat$Education = 2*(ddat$Education=="College")-1
ddat.lmer.max.fix = lmer(RT~Education*SynCat*Freq+((SynCat*Freq)|Participant)+(Education|Item), data = ddat, REML = FALSE)
ddat.lmer.noFreq.fix = lmer(RT~ (Education*SynCat)+(Education*SynCat):Freq+((SynCat*Freq)|Participant)+(Education|Item),REML=FALSE, data = ddat)

anova(ddat.lmer.noFreq.fix, ddat.lmer.max.fix)
## Data: ddat
## Models:
## ddat.lmer.noFreq.fix: RT ~ (Education * SynCat) + (Education * SynCat):Freq + ((SynCat *
## ddat.lmer.noFreq.fix:     Freq) | Participant) + (Education | Item)
## ddat.lmer.max.fix: RT ~ Education * SynCat * Freq + ((SynCat * Freq) | Participant) +
## ddat.lmer.max.fix:     (Education | Item)
