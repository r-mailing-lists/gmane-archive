For completeness, the function below examines the probability of finding
two adjacent bins with 13 or more mutations (about .1)

===== snip
total <- sum(1,7,16,13,11,11,12,10,8,4)
runs <- 10000

two.run <- function(found=13,n.found=13,samp.size=total,bins=10) {
  x <- rle(sort(sample(1:bins,size=samp.size,replace=T)))
  rv <- 0
  if (max(x$lengths) >= found) {
    l <- which(x$lengths==max(x$lengths))
    if (l > 1 && x$lengths[l-1] >= n.found) { rv <- 1}
    if (l < length(x$lengths) && x$lengths[l+1] >= n.found) {rv <- 1}
  }
  return (rv)
}


sum(replicate(runs,two.run(found=13,n.found=13))) / runs

