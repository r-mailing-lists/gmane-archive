# Download page
url <-
  c("https://www.fis-ski.com/DB/general/biographies.html?lastname=&firstname=&sectorcode=AL&gendercode=&birthyear=1961-1962&skiclub=&skis=&nationcode=SUI&fiscode=&status=&search=true")
