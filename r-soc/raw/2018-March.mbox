# Verification through bootstrapping 
#####################################################

install.packages("boot")
library("boot")


fc <- function(d, i){
  d2 <- d[i,]
  m<-tapply(d2$xfemale,d2$female,mean,na.rm=TRUE)
  OR<-(m[2]/(1-m[2]))/(m[1]/(1-m[1]))
  return(log(OR))
}

