#install.packages("boot")
library("boot")


fc <- function(d, i){
  d2 <- d[i,]
  m<-tapply(d2$var,d2$female,mean,na.rm=TRUE)
  OR<-(m[2]/(1-m[2]))/(m[1]/(1-m[1]))
  return(log(OR))
}

# bootstrapping with 1000 replications
results <- boot(d, fc,
                R=1000)
results
plot(results)
summary(results)
boot.ci(boot.out = results, type = c("norm", "basic"))

