  gather(nouvelle_variable, nouvelle_valeur, -c(id:ne_a, ordre)) %>% #
passer en format long
  mutate(nouvelle_variable = paste0(nouvelle_variable, ordre)) %>% #
associer ordre à la variable
  select(-ordre) %>% # se débarasser de la variable d'ordre
