female<-(runif(n)<w)*1
z<-rnorm(n)


target_prop<-0.3
dif_prop<-0.05
sdf2h_ratio<-0.9

var<-ifelse(female==1,pnorm(z,-qnorm(target_prop+dif_prop/2),1/sdf2h_ratio),
            pnorm(z,-qnorm(target_prop-dif_prop/2),sdf2h_ratio))
summary(var)


d<-as.data.frame(cbind(var,female))
d$one<-1


summary(d$var)
summary(d$female)

m<-tapply(d$var,d$female,mean,na.rm=TRUE)
m
