# Example 
#Calculating exposure of females to females in different units (establishment)
#and compare this exposure from that of male to females

#Generation sample
#Parameters
#Number of workers
n<-10000
#segregation parameter (between 0 : no segregation and 1 full segregation)
s<-0.5

#Share of women (between 0 and 1)
w<-0.45
z<-rnorm(n)
unit<-round(z,3)
female<-(((1-s)*rnorm(n)+s*unit)>qnorm(1-w))*1

d<-as.data.frame(cbind(unit,female))
d$one<-1


d<-within(d,{n_unit = ave(one,unit,FUN=sum,na.rm=TRUE)} )
d<-d[d$n_unit>1,]
d<-within(d,{nfemale_unit = ave(female,unit,FUN=sum,na.rm=TRUE)} )
d$xfemale<-ifelse(d$n_u>1,(d$nfemale_unit-d$female)/(d$n_unit-1),NA)
m<-tapply(d$xfemale,d$female,mean,na.rm=TRUE)
sd<-tapply(d$xfemale,d$female,sd,na.rm=TRUE)
var<-tapply(d$xfemale,d$female,var,na.rm=TRUE)
obs<-tapply(is.na(d$female)==FALSE,d$female,sum,na.rm=TRUE)

unit_meansize<-mean(d$n_unit[is.na(d$xfemale)==FALSE],na.rm=TRUE)
nb_unit<-length(table(d$u[is.na(d$xfemale)==FALSE]))

#Available statistics in my data set
