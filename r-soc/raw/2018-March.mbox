Subject: Intervalle de confiance d'un odds ratio de moyennes proportion
In-Reply-To: <CAKc4pTKQeQrN1_irD4kkOWR4h_GzywkT1COUnzsGCAc5z8U-8g@mail.gmail.com>
References: <CAKc4pTKQeQrN1_irD4kkOWR4h_GzywkT1COUnzsGCAc5z8U-8g@mail.gmail.com>
Message-ID: <679adae5-7cfb-d993-e65e-bd5268d50cfe@sciencespo.fr>

Bonjour à tous,


Je calcule des proportions (ici des taux d'expositions aux femmes au 
travail) dans différences unités (établissement) et je calcule des 
moyennes de ces proportions pour l'ensemble de la population. Je voudrai 
comparer de tels moyennes de proportions pour différents groupes ou dans 
le temps, avec un odds ratio, moins sensible aux effets de bord et plus 
comparable. Je me pose la question du calcul d'un intervalle de 
confiance et j'ai pas trouvé de bonnes solutions. Une solution est de 
partir des intervalles de confiance des moyennes de proportion et/ou de 
la différence des moyennes des proportions.
Mais il y a peut-être mieux. Une idée ?

Voici une simulation de mon exemple.

NB: je n'ai pas accès aux données sources, et je ne peux pas envisager 
je crois de bootstrapping.

A bientôt



############################
# Example
#Calculating exposure of females to females in different units 
(establishment)
#and compare this exposure from that of male to females


#Generation sample
n<-100000
unit<-round(runif(n),4)
female<-(runif(n)+unit>1.05)*1
d<-as.data.frame(cbind(unit,female))
d$one<-1

d<-within(d,{n_unit = ave(one,unit,FUN=sum,na.rm=TRUE)} )
d<-within(d,{nfemale_unit = ave(female,unit,FUN=sum,na.rm=TRUE)} )
d$xfemale<-ifelse(d$n_u>1,(d$nfemale_unit-d$female)/(d$n_unit-1),NA)

m<-tapply(d$xfemale,d$female,mean,na.rm=TRUE)
sd<-tapply(d$xfemale,d$female,sd,na.rm=TRUE)
var<-tapply(d$xfemale,d$female,var,na.rm=TRUE)
obs<-tapply(is.na(d$female)==FALSE,d$female,sum,na.rm=TRUE)
unit_meansize<-mean(d$n_unit[is.na(d$xfemale)==FALSE],na.rm=TRUE)
nb_unit<-length(table(d$u[is.na(d$xfemale)==FALSE]))

#Available statistics in my data set
m
sd
se<-sd/(obs)**0.5
se
var
obs
prop.table(obs)
unit_meansize
nb_unit

#Confidence interval for differnce in means
difm<-m[2]-m[1]
var_com<-((var*obs)[1]+(var*obs)[2])/(obs[1]+obs[2]-2)
se_com<-((var_com)**0.5)*((1/obs[1]+1/obs[2])**0.5)
lc95<-difm-1.96*se_com
uc95<-difm+1.96*se_com

m[2]
m[1]
difm
lc95
uc95
se_com

t.test(xfemale~I(1-female),data=d,var.equal=TRUE)


#Confidence interval for my log of odds ratio ?????
OR<-(m[2]/(1-m[2]))/(m[1]/(1-m[1]))
OR
log(OR)

# Here the solution for log OR confidence (1/a+1/b+1/c+1/d)**0.5 is not 
available
# because we don't have just one table but an aggregation of tables.


# Proxy 1 based on the confidence interval each proportions
# Here I use the upper bound and the lower bound of each proportion
# And compute cross comparison
m2l<-m[2]-1.96*(sd[2])/(obs[2])**0.5
m1u<-m[1]+1.96*(sd[1])/(obs[1])**0.5
m1l<-m[1]-1.96*(sd[1])/(obs[1])**0.5
m2u<-m[2]+1.96*(sd[2])/(obs[2])**0.5

# NB : with the technique the confidence interval of the mean is too large
m2l-m1u
lc95

m2u-m1l
uc95

ORl<-(m2l/(1-m2l))/(m1u/(1-m1u))
ORu<-(m2u/(1-m2u))/(m1l/(1-m1l))

OR
ORl
ORu

log(OR)
log(ORl)
log(ORu)


#Proxy 2, based on the confidence interval of the difference of proportions
m2lb<-m[2]-(uc95-difm)/2
m1ub<-m[1]+(uc95-difm)/2

m2ub<-m[2]+(uc95-difm)/2
m1lb<-m[1]-(uc95-difm)/2

difmlb<-m2lb-m1ub
difmub<-m2ub-m1lb

difmlb
lc95

difmub
uc95

ORlb<-(m2lb/(1-m2lb))/(m1ub/(1-m1ub))
ORub<-(m2ub/(1-m2ub))/(m1lb/(1-m1lb))

OR
ORlb
ORub

log(OR)
log(ORlb)
log(ORub)


#Proxy 3, based on the confidence interval of
# the difference of  proportions
c<-(difm-lc95)/(1.96*(se[1]+se[2]))
c

m2lc<-m[2]-c*1.96*(sd[2])/(obs[2])**0.5
m1uc<-m[1]+c*1.96*(sd[1])/(obs[1])**0.5
m1lc<-m[1]-c*1.96*(sd[1])/(obs[1])**0.5
m2uc<-m[2]+c*1.96*(sd[2])/(obs[2])**0.5

m2lc-m1uc-difml
m2uc-m1lc-difmu

ORlc<-(m2lc/(1-m2lc))/(m1uc/(1-m1uc))
ORuc<-(m2uc/(1-m2uc))/(m1lc/(1-m1lc))

OR
ORlc
ORuc

log(OR)
log(ORlc)
log(ORuc)

