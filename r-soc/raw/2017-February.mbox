On peut utiliser assign(). Mais les fonctions qui assigne dans
l’environnement global ne sont pas recommandées…

essai<-function(var_compt,var_regroup)
{
  sortie <- aggregate(iris[,var_compt], list(iris[,var_regroup]), sum)
  assign(x = var_compt, value = sortie, envir = globalenv())
}

essai(var_compt="Petal.Width",var_regroup = "Species")

