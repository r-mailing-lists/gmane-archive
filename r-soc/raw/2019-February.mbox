Une solution R-base:

countsToCases <- function(x, countcol = "COUNT") {
   # Get the row indices to pull from x
   idx <- rep.int(seq_len(nrow(x)), x[[countcol]])

   # Drop count column :=> optionnel !
   x[[countcol]] <- NULL

   # Get the rows from x
   x[idx, ]
}


