Bonjour,

Voici une solution


simplelag <-function(x,mylag=1,outside=NA)
{
   myend<-length(x)- mylag
   y<-c(replicate(mylag,outside),x[1:myend])
}
df$lclass<-simplelag(df$lclass)
df$lclass<-ifelse(simplelag(df$id)!=df$id,NA,df$id)
df$mobA<-(df$class>df$lclass)

